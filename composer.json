{
    "name": "your-org/wp-cbt-pro",
    "description": "Modular computer-based examination platform for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.0",
        "php-stubs/wordpress-stubs": "^6.7",
        "php-stubs/wp-cli-stubs": "^2.11",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "WPCBTPro\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPCBTPro\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit -c phpunit.integration.xml",
        "cs": "phpcs"
    }
}
